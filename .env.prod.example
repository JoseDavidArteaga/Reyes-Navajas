# Variables para el despliegue demo en OCI (Opción A). Copiar a .env.prod y rellenar.
# NUNCA commitear el .env.prod real (tiene secretos).
#
# BACKEND_HOST: slug nip.io de la IP pública de la VM (puntos -> guiones).
#   Ej: si la VM tiene IP 80.90.100.110, BACKEND_HOST=80-90-100-110.nip.io
#   api   -> https://api.80-90-100-110.nip.io  (gateway, vía Nginx+certbot)
#   auth  -> https://auth.80-90-100-110.nip.io (Keycloak, vía Nginx+certbot)
BACKEND_HOST=80-90-100-110.nip.io

# Host del frontend en Vercel (el nombre del proyecto que crees; si es distinto,
# actualiza también keycloak/realm-export.prod.json y environment.prod.ts).
FRONTEND_HOST=reyes-navajas.vercel.app

# MySQL HeatWave: endpoint PRIVADO dentro de la misma VCN (NO la IP pública).
# Puerto 3306. Las 3 BD (barberia, catalogo_db, turnos_db) las crea JPA sola.
MYSQL_HOST=10.0.1.50
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=CAMBIA-ESTA-CLAVE

# Keycloak prod (demo: se permiten claves simples, pero que no sean admin/admin).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CAMBIA-ESTA-CLAVE
# Debe coincidir con el `secret` de auth-service en realm-export.prod.json.
KEYCLOAK_CLIENT_SECRET=PL8IqDY9NnSpW7kMGH7DWSPv29fjdx2X
